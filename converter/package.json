{
  "name": "file-converter-service",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server/main.js",
    "dev": "tsx src/server/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:fast": "node --import tsx --test tests/jobs.test.ts tests/server.test.ts tests/resources.test.ts tests/torrent.test.ts tests/matrix-coverage.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}

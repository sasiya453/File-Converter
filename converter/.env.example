CONVERTER_TOKEN=another-long-random-string
# Comma-separated URL prefixes the service may download from (SSRF guard)
ALLOWED_URL_PREFIXES=https://api.telegram.org/file/
JOB_TIMEOUT_MS=120000
PORT=7860
# Writable scratch dir for per-job temp dirs (HF Spaces: only /tmp is writable)
WORK_ROOT=/tmp/work
# Telegram bot token: the converter uploads results to Telegram itself (POST /jobs)
BOT_TOKEN=123456:replace-me
# Async job queue
MAX_CONCURRENT_JOBS=2
MAX_QUEUE=20
# Jobs that waited longer than this in the queue are dropped with a polite message
JOB_MAX_AGE_MS=600000
